<body>



	<h3>Peliculas vL</h3>
	@if(pelicula1 is null)
	{
		<p>cargando.....</p>
	}
	else
	{
		<div class="mayorconte-img">
			@foreach (var pelicula in pelicula1)
			{
				<div class="cuadro-img">
