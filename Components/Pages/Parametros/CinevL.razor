  

@using Models
@inject HttpClient http

<body>



	<h3>Peliculas vL</h3>
	@if(pelicula1 is null)
	{
		<p>cargando.....</p>
	}
	else
	{
		<div class="mayorconte-img">
			@foreach (var pelicula in pelicula1)
			{
				<div class="cuadro-img">
					<img src="@pelicula.ImagenUrl" />
					<p class="titulo">@pelicula.Titulo </p>
					<p class="categoria">@pelicula.Genero </p>
				</div>
			}
		</div>
	}



</body>


@code {


	List<Pelicula> pelicula1 = new();
	protected override async Task OnInitializedAsync()
	{
		await ObtenerPeliculas();
	}
	public async Task ObtenerPeliculas()
	{
		pelicula1 = await http.GetFromJsonAsync<List<Pelicula>>("https://localhost:7266/api/Pelicula");
	}






}