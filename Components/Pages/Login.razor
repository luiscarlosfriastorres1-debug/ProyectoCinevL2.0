@page "/";
@rendermode InteractiveServer

@using BlazorApp2.Models
@inject HttpClient http
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesión - Películas vL</PageTitle>

<div class="login-page">

    <div class="movie-background">
        @if (pelicula1.Count > 0)
        {
            @for (int i = 0; i < pelicula1.Count && i < 10; i++)
            {
                <div class="movie-card card-@i">
                    <img src="@pelicula1[i].ImagenUrl"
                         alt="@pelicula1[i].Titulo" />
                </div>
            }
        }
    </div>

    <div class="background-overlay"></div>

    <main class="login-content">

        <section class="login-box">

            <div class="login-logo">

                <div class="film-icon">

                    <div class="film-strip">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="play-button"></div>

                    <div class="film-strip">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                </div>

                <h1>Peliculas <strong>vL</strong></h1>

                <p>Tus películas favoritas, en un solo lugar.</p>

            </div>

            <div>

                <div class="input-group">
                    <label>Correo electrónico</label>

                    <input type="email"
                           placeholder="ejemplo@correo.com"
                           class="login-input" @bind="usuario.Correo" required/>
                </div>

                <div class="input-group">
                    <label>Contraseña</label>

                    <input type="password"
                           placeholder="Ingresa tu contraseña"
                           class="login-input" @bind="usuario.Password" required/>
                </div>

                <div class="forgot-password">
                    <a href="/recuperar">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="login-button" @onclick="ValidarLogin">
                    Iniciar sesión
                </button>

            </div>

            <div class="register-text">
                ¿No tienes cuenta?
                <a href="/registro">Regístrate</a>
            </div>

        </section>

    </main>

    <footer class="login-footer">

        <div class="footer-item">
            <div class="footer-icon">♡</div>

            <div>
                <strong>Miles de películas</strong>
                <span>y series</span>
            </div>
        </div>

        <div class="footer-item">
            <div class="footer-icon hd">HD</div>

            <div>
                <strong>Calidad</strong>
                <span>HD y 4K</span>
            </div>
        </div>

        <div class="footer-item">
            <div class="footer-icon">▣</div>

            <div>
                <strong>Disfruta en todos</strong>
                <span>tus dispositivos</span>
            </div>
        </div>

    </footer>

</div>
@code {
    List<Usuario> usuarios = new ();
    Usuario usuario = new();
    List<Pelicula> pelicula1 = new();
    string mensaje = "";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            pelicula1 = await http.GetFromJsonAsync<List<Pelicula>>(
                "https://localhost:7266/api/Pelicula"
            ) ?? new();
        }
        catch
        {
            pelicula1 = new();
        }
    }
    public async Task ValidarLogin()
    {

        usuarios = await http.GetFromJsonAsync<List<Usuario>>("https://localhost:7266/api/Usuarios") ?? new();
        bool validar = usuarios.Any(user => user.Correo == usuario.Correo && user.Password == usuario.Password);
        if (validar)
        {
            Navegacion.NavigateTo("/home");
        }
        else
        {
            mensaje = "Datos incorrectos";
        }

    }
}
